`timescale 1 ps/ 1 ps

module half_adder (
	S,
	C,
	A,
	B);
output 	S;
output 	C;
input 	A;
input 	B;

// Design Ports Information
// S	=>  Location: PIN_N6,	 I/O Standard: 2.5 V,	 Current Strength: Default
// C	=>  Location: PIN_W9,	 I/O Standard: 2.5 V,	 Current Strength: Default
// A	=>  Location: PIN_P6,	 I/O Standard: 2.5 V,	 Current Strength: Default
// B	=>  Location: PIN_W8,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \~QUARTUS_CREATED_GND~I_combout ;
wire \A~input_o ;
wire \B~input_o ;
wire \S~0_combout ;
